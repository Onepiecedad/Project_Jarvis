# Use the official Agent Zero image as base
FROM agent0ai/agent-zero:latest

# Set working directory
WORKDIR /a0

# Copy JARVIS customizations from root (these exist in the repo)
# Prompts (JARVIS identity and system prompts)
COPY prompts/ /a0/prompts/

# Custom agents (Research, Writer, Ops)
COPY agents/ /a0/agents/

# Custom Python tools and helpers (Supabase integration, etc.)
COPY python/ /a0/python/

# Custom instruments if any
COPY instruments/ /a0/instruments/

# Supabase migrations and config
COPY supabase/ /a0/supabase/

# Expose port 80 (Railway will map this automatically)
EXPOSE 80

# The base image already has the entrypoint configured
